{
  "version": 1,
  "default_max_retries": 30,
  "request_timeout": 30,
  "cases": [
    {
      "name": "retry_after_longer_than_http_timeout",
      "method": "GET",
      "responses": [
        {
          "status": 429,
          "retry_after": "60"
        },
        {
          "status": 200
        }
      ],
      "expected_times": [
        0,
        60
      ],
      "expected_status": 200
    },
    {
      "name": "http_date",
      "method": "GET",
      "responses": [
        {
          "status": 429,
          "http_date_seconds": 60
        },
        {
          "status": 200
        }
      ],
      "expected_times": [
        0,
        60
      ],
      "expected_status": 200
    },
    {
      "name": "exponential_cap",
      "method": "GET",
      "responses": [
        {
          "status": 429
        },
        {
          "status": 429
        },
        {
          "status": 429
        },
        {
          "status": 429
        },
        {
          "status": 429
        },
        {
          "status": 429
        },
        {
          "status": 429
        },
        {
          "status": 200
        }
      ],
      "expected_times": [
        0,
        1,
        3,
        7,
        15,
        31,
        51,
        71
      ],
