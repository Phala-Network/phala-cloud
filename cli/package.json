{
	"name": "phala",
	"version": "1.0.39",
	"description": "CLI for Managing Phala Cloud Services",
	"author": {
		"name": "Phala Network",
		"url": "https://github.com/Phala-Network"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Phala-Network/phala-cloud-cli.git"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"!dist/**/*.map",
		"LICENSE",
		"README.md"
	],
	"keywords": ["tee", "phala", "cloud"],
	"type": "module",
	"exports": "./dist/index.js",
	"bin": {
		"phala": "./dist/index.js",
		"pha": "./dist/index.js"
	},
	"scripts": {
		"build": "tsup && bun link",
		"test": "bun test",
		"fmt": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"type-check": "tsc --noEmit",
		"check": "bun run fmt && bun run lint && bun run type-check && bun run test"
	},
	"dependencies": {
		"@phala/cloud": "file:../js",
		"chalk": "5.2.0",
		"commander": "^10.0.1",
		"dedent": "^1.6.0",
		"execa": "^7.2.0",
		"fs-extra": "^11.3.0",
		"handlebars": "^4.7.8",
		"inquirer": "^12.4.2",
		"ora": "^6.3.1",
		"prompts": "^2.4.2",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/bun": "latest",
		"@types/fs-extra": "^11.0.1",
		"@types/inquirer": "^9.0.7",
		"@types/prompts": "^2.4.2",
		"rimraf": "^4.1.3",
		"tsup": "^6.6.3",
		"typescript": "^5.9.2"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
