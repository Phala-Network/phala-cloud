{
	"name": "phala",
	"version": "1.2.9",
	"description": "CLI for Managing Phala Cloud Services",
	"author": {
		"name": "Phala Network",
		"url": "https://github.com/Phala-Network"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Phala-Network/phala-cloud",
		"directory": "cli"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"!dist/**/*.map",
		"LICENSE",
		"README.md"
	],
	"keywords": [
		"tee",
		"phala",
		"cloud"
	],
	"license": "Apache-2.0",
	"type": "module",
	"exports": "./dist/index.js",
	"bin": {
		"phala": "./dist/index.js",
		"pha": "./dist/index.js"
	},
	"scripts": {
		"build": "bun run gen:help && tsup && bun link",
		"gen:help": "bun run scripts/gen-help-topics.ts",
		"test": "bun test --path-ignore-patterns=test/e2e-full/**",
		"test:e2e": "bun test test/e2e-full/",
		"test:interface": "bun test test/interface-compat/",
		"test:all": "bun run test:interface && bun run test:e2e",
		"fmt": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"type-check": "tsc --noEmit",
		"check": "bun run fmt && bun run lint && bun run type-check && bun run test"
	},
	"dependencies": {
		"@iarna/toml": "^2.2.5",
		"@michaelhomer/jqjs": "^1.6.0",
		"@noble/curves": "2.4.0",
		"@phala/cloud": "workspace:*",
		"arg": "^5.0.2",
		"chalk": "6.0.1",
		"dedent": "^1.7.2",
		"execa": "^10.2.1",
		"fs-extra": "^11.4.1",
		"inquirer": "^14.3.1",
		"ofetch": "^1.3.3",
		"open": "^11.0.4",
		"ora": "^10.0.0",
		"prompts": "^2.4.2",
		"semver": "^7.8.6",
		"viem": "^2.58.4",
		"yaml": "^2.9.1",
		"zod": "^4.6.7",
		"@noble/hashes": "2.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@typescript/typescript6": "^6.0.2",
		"@types/bun": "latest",
		"@types/dedent": "^1.7.2",
		"@types/fs-extra": "^11.0.1",
		"@types/inquirer": "^10.0.0",
		"@types/node": "^26.6.6",
		"@types/prompts": "^2.4.2",
		"dotenv": "^18.0.10",
		"tsup": "^9.0.0",
		"type-fest": "^6.0.3",
		"typescript": "^7.0.2"
	}
}
